---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SanityImage from '@/components/ui/SanityImage.astro';
import { toHTML } from '@portabletext/to-html';
import { getClient, sanityClient } from '@/lib/sanity/client';
import { allPostSlugsQuery, postBySlugQuery } from '@/lib/sanity/queries';
import { isPreview } from '@/lib/preview';
import type { Post } from '@/lib/sanity/types';

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch<string[]>(allPostSlugsQuery);
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const preview = isPreview(Astro.cookies);
const post = await getClient(preview).fetch<Post | null>(postBySlugQuery, { slug });

if (!post) {
  return new Response(null, { status: 404 });
}

const bodyHtml = post.body ? toHTML(post.body) : '';
const formattedDate = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString('nl-NL', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;
---

<BaseLayout title={post.title} description={post.excerpt} seo={post.seo}>
  <article class="container-page py-16">
    <header class="mb-10 max-w-prose">
      <h1 class="text-4xl font-bold tracking-tight">{post.title}</h1>
      {formattedDate && <p class="mt-2 text-sm text-slate-500">{formattedDate}</p>}
      {post.author?.name && <p class="mt-1 text-sm text-slate-500">door {post.author.name}</p>}
    </header>
    {post.coverImage?.asset && (
      <div class="mb-10 overflow-hidden rounded-2xl">
        <SanityImage image={post.coverImage} loading="eager" />
      </div>
    )}
    <div class="prose prose-slate max-w-prose" set:html={bodyHtml} />
  </article>
</BaseLayout>
