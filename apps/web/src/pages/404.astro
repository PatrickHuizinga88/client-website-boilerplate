---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Pagina niet gevonden" noIndex>
  <section class="container-page py-24 text-center">
    <p class="text-sm font-medium uppercase tracking-wider text-brand-accent">404</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight">Pagina niet gevonden</h1>
    <p class="mt-4 text-slate-600">
      De pagina die je zoekt bestaat niet of is verplaatst.
    </p>
    <a href="/" class="mt-8 inline-block text-brand-accent hover:underline">Terug naar home</a>
  </section>
</BaseLayout>
