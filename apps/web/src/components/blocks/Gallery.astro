---
import SanityImage from '@/components/ui/SanityImage.astro';
import type { GalleryBlock } from '@/lib/sanity/types';

type Props = { block: GalleryBlock };
const { block } = Astro.props;

const cols = block.columns ?? 3;
const colsClass =
  cols === 2
    ? 'sm:grid-cols-2'
    : cols === 4
      ? 'sm:grid-cols-2 lg:grid-cols-4'
      : 'sm:grid-cols-2 lg:grid-cols-3';
---

<section class="container-page py-12 md:py-16">
  {block.heading && (
    <h2 class="mb-8 text-3xl font-bold tracking-tight text-slate-900">{block.heading}</h2>
  )}
  <ul class={['grid gap-4', colsClass].join(' ')}>
    {block.images?.map((image) => (
      <li class="overflow-hidden rounded-lg">
        <SanityImage image={image} sizes={`(min-width: 1024px) ${100 / cols}vw, 50vw`} />
      </li>
    ))}
  </ul>
</section>
