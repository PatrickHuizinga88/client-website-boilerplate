---
import ContactForm from '@/components/forms/ContactForm.astro';
import { sanityClient } from '@/lib/sanity/client';
import { contactPageQuery } from '@/lib/sanity/queries';
import type { ContactBlock, ContactPage } from '@/lib/sanity/types';

type Props = { block: ContactBlock };
const { block } = Astro.props;

// Pak success/error/privacy teksten uit het contactPage singleton zodat ze één plek hebben.
const contactPage = await sanityClient.fetch<ContactPage | null>(contactPageQuery);
---

<section class="container-page py-12 md:py-16">
  <div class="mx-auto max-w-2xl">
    {block.heading && (
      <h2 class="text-3xl font-bold tracking-tight text-slate-900">{block.heading}</h2>
    )}
    {block.intro && <p class="mt-3 text-slate-600">{block.intro}</p>}
    <div class="mt-8">
      <ContactForm
        successMessage={contactPage?.successMessage}
        errorMessage={contactPage?.errorMessage}
        privacyNotice={contactPage?.privacyNotice}
      />
    </div>
  </div>
</section>
