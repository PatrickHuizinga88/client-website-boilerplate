---
import type { FeaturesBlock } from '@/lib/sanity/types';

type Props = { block: FeaturesBlock };
const { block } = Astro.props;
---

<section class="container-page py-12 md:py-16">
  {(block.heading || block.intro) && (
    <header class="mb-10 max-w-prose">
      {block.heading && (
        <h2 class="text-3xl font-bold tracking-tight text-slate-900">{block.heading}</h2>
      )}
      {block.intro && <p class="mt-3 text-slate-600">{block.intro}</p>}
    </header>
  )}
  <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {block.items?.map((item) => (
      <li>
        {item.icon && <div class="mb-3 text-3xl" aria-hidden="true">{item.icon}</div>}
        <h3 class="text-lg font-semibold text-slate-900">{item.title}</h3>
        {item.body && <p class="mt-2 text-slate-600">{item.body}</p>}
      </li>
    ))}
  </ul>
</section>
