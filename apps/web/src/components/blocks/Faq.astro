---
import type { FaqBlock } from '@/lib/sanity/types';

type Props = { block: FaqBlock };
const { block } = Astro.props;
---

<section class="container-page py-12 md:py-16">
  <div class="mx-auto max-w-3xl">
    {block.heading && (
      <h2 class="mb-8 text-3xl font-bold tracking-tight text-slate-900">{block.heading}</h2>
    )}
    <ul class="divide-y divide-slate-200 border-y border-slate-200">
      {block.items?.map((item) => (
        <li>
          <details class="group py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left font-medium text-slate-900">
              <span>{item.question}</span>
              <span aria-hidden="true" class="shrink-0 text-slate-400 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-slate-600">{item.answer}</p>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>
