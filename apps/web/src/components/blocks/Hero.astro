---
import SanityImage from '@/components/ui/SanityImage.astro';
import Button from '@/components/ui/Button.astro';
import type { HeroBlock } from '@/lib/sanity/types';

type Props = { block: HeroBlock };
const { block } = Astro.props;
---

<section class="container-page py-16 md:py-24">
  <div class="grid items-center gap-12 md:grid-cols-2">
    <div>
      {block.eyebrow && (
        <p class="mb-3 text-sm font-medium uppercase tracking-wider text-brand-accent">
          {block.eyebrow}
        </p>
      )}
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 md:text-5xl">
        {block.title}
      </h1>
      {block.subtitle && (
        <p class="mt-4 max-w-prose text-lg text-slate-600">{block.subtitle}</p>
      )}
      {block.cta?.href && (
        <div class="mt-8">
          <Button href={block.cta.href} external={block.cta.type === 'external'}>
            {block.cta.label}
          </Button>
        </div>
      )}
    </div>
    {block.image?.asset && (
      <div class="overflow-hidden rounded-2xl">
        <SanityImage image={block.image} loading="eager" sizes="(min-width: 768px) 50vw, 100vw" />
      </div>
    )}
  </div>
</section>
