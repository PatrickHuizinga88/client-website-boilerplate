---
import type { SiteSettings } from '@/lib/sanity/types';

type Props = { settings?: SiteSettings | null };
const { settings } = Astro.props;
---

<header class="border-b border-slate-200 bg-white">
  <div class="container-page flex items-center justify-between py-4">
    <a href="/" class="text-lg font-semibold text-slate-900">
      {settings?.title ?? 'Site'}
    </a>
    <nav aria-label="Hoofdnavigatie">
      <ul class="flex items-center gap-6 text-sm text-slate-700">
        <li><a href="/" class="hover:text-brand-accent">Home</a></li>
        <li><a href="/blog" class="hover:text-brand-accent">Blog</a></li>
      </ul>
    </nav>
  </div>
</header>
