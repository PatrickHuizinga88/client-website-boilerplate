---
import type { SiteSettings } from '@/lib/sanity/types';

type Props = { settings?: SiteSettings | null };
const { settings } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-slate-200 bg-slate-50">
  <div class="container-page py-10">
    <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
      <div class="text-sm text-slate-600">
        <p class="font-medium text-slate-900">{settings?.title ?? 'Site'}</p>
        {settings?.contact?.email && (
          <a href={`mailto:${settings.contact.email}`} class="mt-1 inline-block hover:text-brand-accent">
            {settings.contact.email}
          </a>
        )}
      </div>
      <nav aria-label="Voettekst-navigatie">
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-600">
          <li><a href="/contact" class="hover:text-brand-accent">Contact</a></li>
          <li><a href="/privacybeleid" class="hover:text-brand-accent">Privacybeleid</a></li>
          <li><a href="/cookiebeleid" class="hover:text-brand-accent">Cookiebeleid</a></li>
          <li><a href="/algemene-voorwaarden" class="hover:text-brand-accent">Algemene voorwaarden</a></li>
        </ul>
      </nav>
    </div>
    <p class="mt-8 border-t border-slate-200 pt-6 text-xs text-slate-500">
      © {year} {settings?.title ?? 'Site'}. Alle rechten voorbehouden.
    </p>
  </div>
</footer>
