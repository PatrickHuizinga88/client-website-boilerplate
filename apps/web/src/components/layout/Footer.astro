---
import type { SiteSettings } from '@/lib/sanity/types';

type Props = { settings?: SiteSettings | null };
const { settings } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-slate-200 bg-slate-50">
  <div class="container-page flex flex-col gap-4 py-8 text-sm text-slate-600 md:flex-row md:items-center md:justify-between">
    <p>© {year} {settings?.title ?? 'Site'}. Alle rechten voorbehouden.</p>
    {settings?.contact?.email && (
      <a href={`mailto:${settings.contact.email}`} class="hover:text-brand-accent">
        {settings.contact.email}
      </a>
    )}
  </div>
</footer>
