# Sanity
PUBLIC_SANITY_PROJECT_ID=your-project-id
PUBLIC_SANITY_DATASET=development
PUBLIC_SANITY_API_VERSION=2025-01-01

# Sanity tokens (server-side only, never exposed to the browser)
# Read token: drafts + preview mode
SANITY_API_READ_TOKEN=
# Write token: optional, only needed if forms write back to Sanity
SANITY_API_WRITE_TOKEN=

# Resend (transactional email for contact form)
RESEND_API_KEY=
# Verified sender ("Site <noreply@yourdomain.com>")
RESEND_FROM_EMAIL=
# Fallback recipient if niet ingesteld in Sanity contactPage
CONTACT_TO_EMAIL=

# Cloudflare Turnstile (spam protection — optional)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Site
PUBLIC_SITE_URL=http://localhost:4321

# Umami analytics (optional — leave empty to disable)
# Cloud: https://cloud.umami.is/script.js — Self-hosted: https://stats.example.com/script.js
PUBLIC_UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=
